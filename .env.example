# GestureSlides Environment Configuration
# Copy this file to .env and modify as needed

# Camera settings
# CAMERA_INDEX=0
# FRAME_WIDTH=640
# FRAME_HEIGHT=480
# TARGET_FPS=30

# Gesture detection thresholds
# SWIPE_THRESHOLD=0.04
# SWIPE_WINDOW_SEC=0.45
# SWIPE_MIN_SAMPLES=4
# FIST_FRAMES_REQUIRED=3
# GESTURE_COOLDOWN_SEC=0.9

# Web dashboard
# WEB_SERVER_HOST=127.0.0.1
# WEB_SERVER_PORT=7474
# ENABLE_CAMERA_PREVIEW=true

# Logging
# LOG_LEVEL=INFO
# MAX_LOG_AGE_DAYS=7
